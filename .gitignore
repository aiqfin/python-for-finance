# ---- 虚拟环境与 IDE ----
.venv/
.vscode/
.workbuddy/
.qoder/

# ---- 手工备份 ----
Backups/

# ---- LaTeX 编译产物 ----
*.aux
*.log
*.nav
*.out
*.snm
*.toc
*.vrb
*.bbl
*.blg
*.synctex.gz
*.fls
*.fdb_latexmk
texput.log
*.*.minted

# ---- PDF（课件成品，编译即可再生成）----
*.pdf
# 但保留 Beamer 主题所需的 logo/背景图
!**/logo/*.pdf

# ---- 超大样本数据文件（>5MB，仅保留在本地）----
US_Baby_Names_right.csv
Online_Retail.csv
fxcm_eur_usd_tick_data.csv

# ---- 系统临时文件 ----
.DS_Store
Thumbs.db
desktop.ini

# ---- Python 运行产物 ----
__pycache__/
.ipynb_checkpoints/
# notebook 运行时生成的中间文件
**/outputs/notes.txt
**/outputs/stats*.csv
**/outputs/spy_vol21.*
**/outputs/prices.png
**/outputs/demo_prices.csv

# ---- 本地临时文件 ----
/tmp*/

# ---- 本地数据包与二进制数据（各章节通用）----
*.zip
*.7z
*.rar
*.tar
*.tar.gz
*.tgz
*.h5
*.hdf5
*.parquet
# 原始数据及处理缓存；CSV示例、outputs中的汇总表仍可提交
**/data/raw/
**/data/processed/
